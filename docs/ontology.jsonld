}, {
  "@id" : "http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Polina Svetlinova"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@value" : "This ontology is a formal and semantic representation of the catalog of medical and in vitro diagnostic devices operating under the European Union's legal framework. The model structures the relationship between products, their risk levels (according to MDR and IVDR), the responsible parties (manufacturers), and the surveillance cycle (incidents and corrective actions). Its objective is to provide a shared knowledge base that facilitates clinical safety traceability."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@value" : "EUDAMED-SRO (EUDAMED Semantic Regulation Ontology)"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTime",
    "@value" : "2026-04-27T00:00:00"
  } ],
  "http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#vann:preferredNamespacePrefix" : [ {
    "@value" : "SRO"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@value" : "V1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "This ontology provides a formal framework for representing medical device safety data and post-market surveillance under the EUDAMED regulatory context. It defines core classes such as Medical Devices, Manufacturers, and Incidents, along with their hierarchical relationships and safety risks. By leveraging standardized vocabularies like Schema.org and Dublin Core, the model ensures semantic interoperability for tracking corrective actions and serious adverse events, facilitating structured data exchange within the European medical device ecosystem."
  }, {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "1.0"
  }, {
    "@value" : "First Version of EUDAMED-SRO (EUDAMED Semantic Regulation Ontology)"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A medical device that depends on a source of energy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@value" : "Polina Petrova"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
