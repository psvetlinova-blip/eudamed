  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An active medical device designed to be implanted in the body and powered by an internal or external energy source."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
