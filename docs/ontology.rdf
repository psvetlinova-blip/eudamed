    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>A medical device that depends on a source of energy.</rdfs:comment>
        <rdfs:isDefinedBy>Polina Petrova</rdfs:isDefinedBy>
        <rdfs:label>ActiveDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveImplant -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveImplant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>An active medical device designed to be implanted in the body and powered by an internal or external energy source.</rdfs:comment>
        <rdfs:isDefinedBy>Polina Petrova</rdfs:isDefinedBy>
        <rdfs:label>ActiveImplant</rdfs:label>
        <owl:priorVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</owl:priorVersion>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ContaminationRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ContaminationRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk of contamination affecting the safety or effectiveness of a device.</rdfs:comment>
        <rdfs:label>Contamination Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#CybersecurityRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#CybersecurityRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk related to unauthorized access, cyberattacks, or data breaches involving the device.</rdfs:comment>
        <rdfs:label>Cybersecurity Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device">
        <dc:title>Device</dc:title>
        <rdfs:comment>Device</rdfs:comment>
        <rdfs:label>Device</rdfs:label>
        <rdfs:seeAlso>https://dbpedia.org/resource/Medical_device</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceFailure -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceFailure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
        <rdfs:comment>The combination of the likelihood of occurrence of harm and the severity of that harm.</rdfs:comment>
        <rdfs:label>DeviceFailure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceFailureIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceFailureIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
        <rdfs:comment>Incident where Device Failured</rdfs:comment>
        <rdfs:label>DeviceFailureIncident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DevicePerformance -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DevicePerformance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
        <rdfs:comment>A malfunction or breakdown of a device that prevents it from performing as intended.</rdfs:comment>
        <rdfs:label>DevicePerformance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceSafety -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceSafety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
        <rdfs:comment>A problem related to the device not achieving its expected performance.</rdfs:comment>
        <rdfs:label>Device Performance Issue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DiagnosticError -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DiagnosticError">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
        <rdfs:comment>A risk associated with unsafe conditions or improper functioning of a device.</rdfs:comment>
        <rdfs:label>Device Safety Issue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DiagnosticRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DiagnosticRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk of incorrect or delayed diagnosis due to device limitations or errors.</rdfs:comment>
        <rdfs:label>Diagnostic Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA">
        <rdfs:comment>An action taken by a manufacturer to reduce the risk of death or serious deterioration in health associated with a medical device already placed on the market.</rdfs:comment>
        <rdfs:label>Field Safety Corrective Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ImplantableActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>A medical device intended to be totally or partially introduced into the human body and remain there after the procedure, requiring a source of energy to operate.</rdfs:comment>
        <rdfs:label>Implantable Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ImplantableDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>A medical device intended to be placed inside the human body, either permanently or for a prolonged period.</rdfs:comment>
        <rdfs:comment>Implantable Device</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InSituCorrection -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InSituCorrection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA"/>
        <rdfs:comment>A corrective action performed directly on the device at its location without removing it from service.</rdfs:comment>
        <rdfs:comment>In Situ Correction</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>A device used to perform tests on samples such as blood or tissue taken from the human body.</rdfs:comment>
        <rdfs:label>In Vitro Diagnostic Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident">
        <rdfs:comment>An event related to the use of a medical device that has caused or could potentially cause harm.</rdfs:comment>
        <rdfs:label>Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InfectionRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InfectionRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk of infection caused by contamination or improper sterilization of the device.</rdfs:comment>
        <rdfs:label>Infection Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InjuryRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InjuryRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk of physical harm or injury resulting from the use of a device.</rdfs:comment>
        <rdfs:label>Injury Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InterferenceRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InterferenceRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk caused by external interference affecting the device’s operation</rdfs:comment>
        <rdfs:label>Interference Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#MalfunctionRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#MalfunctionRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk associated with device malfunction or incorrect functioning</rdfs:comment>
        <rdfs:label>Malfunction Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ManufacturerWithSeriousIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ManufacturerWithSeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Organization"/>
        <rdfs:comment>Manufacturer With Serious Incident</rdfs:comment>
        <rdfs:label>ManufacturerWithSeriousIncident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#MaterialRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#MaterialRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk arising from the materials used in the device, such as toxicity or incompatibility.</rdfs:comment>
        <rdfs:label>Material Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#NearMissIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#NearMissIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
        <rdfs:label>An incident that did not result in harm but had the potential to do so under slightly different circumstances.</rdfs:label>
        <rdfs:label>Near Miss Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Organization -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Organization">
        <rdfs:comment>An organization responsible for designing, producing, packaging, and labeling a medical device before placing it on the market.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
        <rdfs:seeAlso>https://dbpedia.org/resource/Manufacturer</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#PatientHarm -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#PatientHarm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
        <rdfs:comment>An error in diagnosis caused by incorrect or misleading results from a medical device.</rdfs:comment>
        <rdfs:label>PatientHarm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#PatientHarmIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#PatientHarmIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
        <rdfs:comment>Incident where patient is harmed</rdfs:comment>
        <rdfs:label>PatientHarmIncident</rdfs:label>
        <rdfs:seeAlso>https://dbpedia.org/resource/Adverse_event</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ProductQuality -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ProductQuality">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
        <rdfs:comment>A defect or deficiency in a device that affects its quality, safety, or performance.</rdfs:comment>
        <rdfs:label>Product Quality Issue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RadiationRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RadiationRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk associated with exposure to radiation emitted by a device.</rdfs:comment>
        <rdfs:label>Radiation Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Recall -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Recall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA"/>
        <rdfs:comment>An action aimed at returning or removing a medical device from the market due to safety concerns.</rdfs:comment>
        <rdfs:label>Recall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk">
        <rdfs:comment>Risk</rdfs:comment>
        <rdfs:label>Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType">
        <rdfs:comment>A classification category used to group different types of risks associated with medical devices.</rdfs:comment>
        <rdfs:label>Risk Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SafetyAlert -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SafetyAlert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA"/>
        <rdfs:comment>A formal notification issued to inform users about potential risks or safety issues related to a device.</rdfs:comment>
        <rdfs:label>Safety Alert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SelfTestDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SelfTestDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>A device intended to be used by laypersons for diagnostic purposes without professional supervision.</rdfs:comment>
        <rdfs:label>Self-Test Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SeriousIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
        <rdfs:comment>Serius Incident</rdfs:comment>
        <rdfs:label>SeriusIncident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SingleUseDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SingleUseDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:comment>A medical device intended to be used on a single patient during a single procedure and not to be reused.</rdfs:comment>
        <rdfs:label>Single Use Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SoftwareRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SoftwareRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
        <rdfs:comment>Risk related to software faults, errors, or vulnerabilities in the device.</rdfs:comment>
        <rdfs:label>Software Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#UserNotice -->


    <owl:Class rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#UserNotice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA"/>
        <rdfs:comment>A communication provided to users containing important safety or usage information about a medical device.</rdfs:comment>
        <rdfs:label>User Notice</rdfs:label>
    </owl:Class>
    


