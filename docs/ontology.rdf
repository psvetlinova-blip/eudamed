    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#risk_name">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
