    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#associatedRiskType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#associatedRiskType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#associatedRiskType"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#associatedRiskType"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:isDefinedBy>Polina Petrova</rdfs:isDefinedBy>
        <rdfs:label>Relates a risk instance to its corresponding risk type classification</rdfs:label>
        <rdfs:label>associated risk type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasAssociatedRisk -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasAssociatedRisk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasAssociatedRisk"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasAssociatedRisk"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Indicates the risk or risks linked to a specific incident.</rdfs:comment>
        <rdfs:label>hasAssociateadRisk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasManufacturer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Organization"/>
        <rdfs:comment>Links a medical device to the organization responsible for its manufacture.</rdfs:comment>
        <rdfs:label>hasManufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#involvesDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#involvesDevice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
