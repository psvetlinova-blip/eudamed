<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#"
     xml:base="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#vann:"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:untitled-ontology-16="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16">
        <dc:creator>Polina Svetlinova</dc:creator>
        <dc:description>This ontology is a formal and semantic representation of the catalog of medical and in vitro diagnostic devices operating under the European Union&apos;s legal framework. The model structures the relationship between products, their risk levels (according to MDR and IVDR), the responsible parties (manufacturers), and the surveillance cycle (incidents and corrective actions). Its objective is to provide a shared knowledge base that facilitates clinical safety traceability.</dc:description>
        <dc:title>EUDAMED-SRO (EUDAMED Semantic Regulation Ontology)</dc:title>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-27T00:00:00</terms:created>
        <vann:preferredNamespacePrefix>SRO</vann:preferredNamespacePrefix>
        <owl:versionIRI>V1.0</owl:versionIRI>
        <owl:versionInfo xml:lang="en">This ontology provides a formal framework for representing medical device safety data and post-market surveillance under the EUDAMED regulatory context. It defines core classes such as Medical Devices, Manufacturers, and Incidents, along with their hierarchical relationships and safety risks. By leveraging standardized vocabularies like Schema.org and Dublin Core, the model ensures semantic interoperability for tracking corrective actions and serious adverse events, facilitating structured data exchange within the European medical device ecosystem.</owl:versionInfo>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</owl:versionInfo>
        <owl:versionInfo>First Version of EUDAMED-SRO (EUDAMED Semantic Regulation Ontology)</owl:versionInfo>
    </owl:Ontology>
    


