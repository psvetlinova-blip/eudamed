                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#involvesDevice"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Involves Device</rdfs:comment>
        <rdfs:label>involvesDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#mitigates -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#mitigates">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:nodeID="genid7"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#mitigates"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Indicates that a corrective action reduces or eliminates the impact or likelihood of an incident or associated risk.</rdfs:comment>
        <rdfs:label>mitigates</rdfs:label>
    </owl:ObjectProperty>
    <owl:Restriction rdf:nodeID="genid7">
        <owl:onProperty rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#mitigates"/>
        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#mitigates"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
        <owl:annotatedTarget rdf:nodeID="genid7"/>
        <rdfs:comment></rdfs:comment>
    </owl:Axiom>
    


