    <!-- http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#scope -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#scope">
