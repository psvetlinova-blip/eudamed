                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :DeviceFailure ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16/r>
                                                                           ] ;
