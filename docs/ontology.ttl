                  rdfs:domain :Incident ;
                  rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :FSCA ,
                         :Incident ,
                         :Risk ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#detection_date
:detection_date rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain :Incident ;
                rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#device_type
:device_type rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Device ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#devices_affected
:devices_affected rdf:type owl:DatatypeProperty ;
