                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasAssociatedRisk ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16/i> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16/r>
                                                                ] ;
