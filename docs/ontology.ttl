                  rdfs:range xsd:integer .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#email
:email rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Organization ;
       rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#eudamed_fsca_ref
:eudamed_fsca_ref rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :FSCA ;
                  rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#eudamed_incident_ref
:eudamed_incident_ref rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain :Incident ;
                      rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#eudamed_srn
:eudamed_srn rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Organization ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#event_date
:event_date rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#imdrf_code
:imdrf_code rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Risk ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#intended_purpose
:intended_purpose rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :Device ;
                  rdfs:range xsd:string .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#is_active
:is_active rdf:type owl:DatatypeProperty ;
