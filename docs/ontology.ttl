              rdf:type owl:FunctionalProperty ;
              rdfs:domain :FSCA ;
              rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#competent_authority
:competent_authority rdf:type owl:DatatypeProperty ;
