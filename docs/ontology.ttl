###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#corrective_action_taken
:corrective_action_taken rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain :Incident ;
                         rdfs:range xsd:boolean .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#countries_affected
:countries_affected rdf:type owl:DatatypeProperty ;
