@prefix : <http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16> .

<http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16> rdf:type owl:Ontology ;
                                                                            <http://purl.org/dc/elements/1.1/creator> "Polina Svetlinova" ;
                                                                            <http://purl.org/dc/elements/1.1/description> "This ontology is a formal and semantic representation of the catalog of medical and in vitro diagnostic devices operating under the European Union's legal framework. The model structures the relationship between products, their risk levels (according to MDR and IVDR), the responsible parties (manufacturers), and the surveillance cycle (incidents and corrective actions). Its objective is to provide a shared knowledge base that facilitates clinical safety traceability." ;
                                                                            <http://purl.org/dc/elements/1.1/title> "EUDAMED-SRO (EUDAMED Semantic Regulation Ontology)" ;
                                                                            <http://purl.org/dc/terms/created> "2026-04-27T00:00:00"^^xsd:dateTime ;
                                                                            :vann:preferredNamespacePrefix "SRO" ;
                                                                            owl:versionIRI "V1.0" ;
                                                                            owl:versionInfo "This ontology provides a formal framework for representing medical device safety data and post-market surveillance under the EUDAMED regulatory context. It defines core classes such as Medical Devices, Manufacturers, and Incidents, along with their hierarchical relationships and safety risks. By leveraging standardized vocabularies like Schema.org and Dublin Core, the model ensures semantic interoperability for tracking corrective actions and serious adverse events, facilitating structured data exchange within the European medical device ecosystem."@en ,
                                                                                            1.0 ,
                                                                                            "First Version of EUDAMED-SRO (EUDAMED Semantic Regulation Ontology)" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#vann:preferredNamespacePrefix
:vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdfs:comment "The date on which the corrective action was initiated or carried out." .


###  http://www.w3.org/2002/07/owl#versionIRI
owl:versionIRI rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#associatedRiskType
:associatedRiskType rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain [ rdf:type owl:Restriction ;
                                  owl:onProperty :associatedRiskType ;
                                  owl:allValuesFrom :Risk
                                ] ;
                    rdfs:range [ rdf:type owl:Restriction ;
                                 owl:onProperty :associatedRiskType ;
                                 owl:allValuesFrom :RiskType
                               ] ;
                    rdfs:isDefinedBy "Polina Petrova" ;
                    rdfs:label "Relates a risk instance to its corresponding risk type classification" ,
                               "associated risk type" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasAssociatedRisk
:hasAssociatedRisk rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasAssociatedRisk ;
                                 owl:allValuesFrom :Incident
                               ] ;
                   rdfs:range [ rdf:type owl:Restriction ;
                                owl:onProperty :hasAssociatedRisk ;
                                owl:allValuesFrom :Risk
                              ] ;
                   rdfs:comment "Indicates the risk or risks linked to a specific incident." ;
                   rdfs:label "hasAssociateadRisk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Device ;
                 rdfs:range :Organization ;
                 rdfs:comment "Links a medical device to the organization responsible for its manufacture." ;
                 rdfs:label "hasManufacturer" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#involvesDevice
:involvesDevice rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Restriction ;
                              owl:onProperty :involvesDevice ;
                              owl:allValuesFrom :Incident
                            ] ;
                rdfs:range [ rdf:type owl:Restriction ;
                             owl:onProperty :involvesDevice ;
                             owl:allValuesFrom :Device
                           ] ;
                rdfs:comment "Involves Device" ;
                rdfs:label "involvesDevice" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#mitigates
:mitigates rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain _:genid7 ;
           rdfs:range [ rdf:type owl:Restriction ;
                        owl:onProperty :mitigates ;
                        owl:allValuesFrom :Incident
                      ] ;
           rdfs:comment "Indicates that a corrective action reduces or eliminates the impact or likelihood of an incident or associated risk." ;
           rdfs:label "mitigates" .

_:genid7 rdf:type owl:Restriction ;
          owl:onProperty :mitigates ;
          owl:allValuesFrom :FSCA .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :mitigates ;
   owl:annotatedProperty rdfs:domain ;
   owl:annotatedTarget _:genid7 ;
   rdfs:comment ""
 ] .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#reporting
:reporting rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Incident ;
           rdfs:range :Organization ;
           rdfs:comment "Reporting" ;
           rdfs:label "reporting" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#action_date
:action_date rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :FSCA ;
             rdfs:range xsd:dateTime ;
             rdfs:label "action_date" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#affected_device_type
:affected_device_type rdf:type owl:DatatypeProperty ;
