:udi_di rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :Device ;
        rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveDevice
:ActiveDevice rdf:type owl:Class ;
              rdfs:subClassOf :Device ;
              rdfs:comment "A medical device that depends on a source of energy." ;
              rdfs:isDefinedBy "Polina Petrova" ;
              rdfs:label "ActiveDevice" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ActiveImplant
:ActiveImplant rdf:type owl:Class ;
               rdfs:subClassOf :Device ;
               rdfs:comment "An active medical device designed to be implanted in the body and powered by an internal or external energy source." ;
               rdfs:isDefinedBy "Polina Petrova" ;
               rdfs:label "ActiveImplant" ;
               owl:priorVersion 1.0 .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ContaminationRisk
:ContaminationRisk rdf:type owl:Class ;
                   rdfs:subClassOf :RiskType ;
                   rdfs:comment "Risk of contamination affecting the safety or effectiveness of a device." ;
                   rdfs:label "Contamination Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#CybersecurityRisk
:CybersecurityRisk rdf:type owl:Class ;
                   rdfs:subClassOf :RiskType ;
                   rdfs:comment "Risk related to unauthorized access, cyberattacks, or data breaches involving the device." ;
                   rdfs:label "Cybersecurity Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Device
:Device rdf:type owl:Class ;
        <http://purl.org/dc/elements/1.1/title> "Device" ;
        rdfs:comment "Device" ;
        rdfs:label "Device" ;
        rdfs:seeAlso "https://dbpedia.org/resource/Medical_device" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceFailure
:DeviceFailure rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "The combination of the likelihood of occurrence of harm and the severity of that harm." ;
               rdfs:label "DeviceFailure" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceFailureIncident
:DeviceFailureIncident rdf:type owl:Class ;
                       rdfs:subClassOf :Incident ;
                       rdfs:comment "Incident where Device Failured" ;
                       rdfs:label "DeviceFailureIncident" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DevicePerformance
:DevicePerformance rdf:type owl:Class ;
                   rdfs:subClassOf :Risk ;
                   rdfs:comment "A malfunction or breakdown of a device that prevents it from performing as intended." ;
                   rdfs:label "DevicePerformance" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DeviceSafety
:DeviceSafety rdf:type owl:Class ;
              rdfs:subClassOf :Risk ;
              rdfs:comment "A problem related to the device not achieving its expected performance." ;
              rdfs:label "Device Performance Issue" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DiagnosticError
:DiagnosticError rdf:type owl:Class ;
                 rdfs:subClassOf :Risk ;
                 rdfs:comment "A risk associated with unsafe conditions or improper functioning of a device." ;
                 rdfs:label "Device Safety Issue" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#DiagnosticRisk
:DiagnosticRisk rdf:type owl:Class ;
                rdfs:subClassOf :RiskType ;
                rdfs:comment "Risk of incorrect or delayed diagnosis due to device limitations or errors." ;
                rdfs:label "Diagnostic Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#FSCA
:FSCA rdf:type owl:Class ;
      rdfs:comment "An action taken by a manufacturer to reduce the risk of death or serious deterioration in health associated with a medical device already placed on the market." ;
      rdfs:label "Field Safety Corrective Action" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ImplantableActiveDevice
:ImplantableActiveDevice rdf:type owl:Class ;
                         rdfs:subClassOf :Device ;
                         rdfs:comment "A medical device intended to be totally or partially introduced into the human body and remain there after the procedure, requiring a source of energy to operate." ;
                         rdfs:label "Implantable Active Device" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ImplantableDevice
:ImplantableDevice rdf:type owl:Class ;
                   rdfs:subClassOf :Device ;
                   rdfs:comment "A medical device intended to be placed inside the human body, either permanently or for a prolonged period." ,
                                "Implantable Device" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InSituCorrection
:InSituCorrection rdf:type owl:Class ;
                  rdfs:subClassOf :FSCA ;
                  rdfs:comment "A corrective action performed directly on the device at its location without removing it from service." ,
                               "In Situ Correction" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InVitroDiagnosticDevice
:InVitroDiagnosticDevice rdf:type owl:Class ;
                         rdfs:subClassOf :Device ;
                         rdfs:comment "A device used to perform tests on samples such as blood or tissue taken from the human body." ;
                         rdfs:label "In Vitro Diagnostic Device" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Incident
:Incident rdf:type owl:Class ;
          rdfs:comment "An event related to the use of a medical device that has caused or could potentially cause harm." ;
          rdfs:label "Incident" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InfectionRisk
:InfectionRisk rdf:type owl:Class ;
               rdfs:subClassOf :RiskType ;
               rdfs:comment "Risk of infection caused by contamination or improper sterilization of the device." ;
               rdfs:label "Infection Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InjuryRisk
:InjuryRisk rdf:type owl:Class ;
            rdfs:subClassOf :RiskType ;
            rdfs:comment "Risk of physical harm or injury resulting from the use of a device." ;
            rdfs:label "Injury Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#InterferenceRisk
:InterferenceRisk rdf:type owl:Class ;
                  rdfs:subClassOf :RiskType ;
                  rdfs:comment "Risk caused by external interference affecting the device’s operation" ;
                  rdfs:label "Interference Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#MalfunctionRisk
:MalfunctionRisk rdf:type owl:Class ;
                 rdfs:subClassOf :RiskType ;
                 rdfs:comment "Risk associated with device malfunction or incorrect functioning" ;
                 rdfs:label "Malfunction Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ManufacturerWithSeriousIncident
:ManufacturerWithSeriousIncident rdf:type owl:Class ;
                                 rdfs:subClassOf :Organization ;
                                 rdfs:comment "Manufacturer With Serious Incident" ;
                                 rdfs:label "ManufacturerWithSeriousIncident" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#MaterialRisk
:MaterialRisk rdf:type owl:Class ;
              rdfs:subClassOf :RiskType ;
              rdfs:comment "Risk arising from the materials used in the device, such as toxicity or incompatibility." ;
              rdfs:label "Material Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#NearMissIncident
:NearMissIncident rdf:type owl:Class ;
                  rdfs:subClassOf :Incident ;
                  rdfs:label "An incident that did not result in harm but had the potential to do so under slightly different circumstances." ,
                             "Near Miss Incident" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Organization
:Organization rdf:type owl:Class ;
              rdfs:comment "An organization responsible for designing, producing, packaging, and labeling a medical device before placing it on the market." ;
              rdfs:label "Manufacturer" ;
              rdfs:seeAlso "https://dbpedia.org/resource/Manufacturer" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#PatientHarm
:PatientHarm rdf:type owl:Class ;
             rdfs:subClassOf :Risk ;
             rdfs:comment "An error in diagnosis caused by incorrect or misleading results from a medical device." ;
             rdfs:label "PatientHarm" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#PatientHarmIncident
:PatientHarmIncident rdf:type owl:Class ;
                     rdfs:subClassOf :Incident ;
                     rdfs:comment "Incident where patient is harmed" ;
                     rdfs:label "PatientHarmIncident" ;
                     rdfs:seeAlso "https://dbpedia.org/resource/Adverse_event" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#ProductQuality
:ProductQuality rdf:type owl:Class ;
                rdfs:subClassOf :Risk ;
                rdfs:comment "A defect or deficiency in a device that affects its quality, safety, or performance." ;
                rdfs:label "Product Quality Issue" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RadiationRisk
:RadiationRisk rdf:type owl:Class ;
               rdfs:subClassOf :RiskType ;
               rdfs:comment "Risk associated with exposure to radiation emitted by a device." ;
               rdfs:label "Radiation Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Recall
:Recall rdf:type owl:Class ;
        rdfs:subClassOf :FSCA ;
        rdfs:comment "An action aimed at returning or removing a medical device from the market due to safety concerns." ;
        rdfs:label "Recall" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#Risk
:Risk rdf:type owl:Class ;
      rdfs:comment "Risk" ;
      rdfs:label "Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#RiskType
:RiskType rdf:type owl:Class ;
          rdfs:comment "A classification category used to group different types of risks associated with medical devices." ;
          rdfs:label "Risk Type" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SafetyAlert
:SafetyAlert rdf:type owl:Class ;
             rdfs:subClassOf :FSCA ;
             rdfs:comment "A formal notification issued to inform users about potential risks or safety issues related to a device." ;
             rdfs:label "Safety Alert" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SelfTestDevice
:SelfTestDevice rdf:type owl:Class ;
                rdfs:subClassOf :Device ;
                rdfs:comment "A device intended to be used by laypersons for diagnostic purposes without professional supervision." ;
                rdfs:label "Self-Test Device" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SeriousIncident
:SeriousIncident rdf:type owl:Class ;
                 rdfs:subClassOf :Incident ;
                 rdfs:comment "Serius Incident" ;
                 rdfs:label "SeriusIncident" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SingleUseDevice
:SingleUseDevice rdf:type owl:Class ;
                 rdfs:subClassOf :Device ;
                 rdfs:comment "A medical device intended to be used on a single patient during a single procedure and not to be reused." ;
                 rdfs:label "Single Use Device" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#SoftwareRisk
:SoftwareRisk rdf:type owl:Class ;
              rdfs:subClassOf :RiskType ;
              rdfs:comment "Risk related to software faults, errors, or vulnerabilities in the device." ;
              rdfs:label "Software Risk" .


###  http://www.semanticweb.org/polina/ontologies/2026/3/untitled-ontology-16#UserNotice
:UserNotice rdf:type owl:Class ;
            rdfs:subClassOf :FSCA ;
            rdfs:comment "A communication provided to users containing important safety or usage information about a medical device." ;
            rdfs:label "User Notice" .


